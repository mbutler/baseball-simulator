{
  "name": "roll",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "start": "bun build --minify src/index.ts --watch --outfile ./dist/js/bundle.js",
    "docs": "documentation build src/** -f html -o docs --shallow",
    "update-dataset": "bun run src/scripts/updateDataset.ts",
    "monte-carlo": "bun run src/scripts/monteCarloValidate.ts",
    "monte-carlo-league": "bun run src/scripts/monteCarloValidate.ts 400 --multi",
    "fetch-count-data": "bun run src/scripts/fetchCountData.ts",
    "build-count-profiles": "bun run src/scripts/buildCountProfiles.ts",
    "shift-policy": "bun run src/scripts/shiftPolicySim.ts",
    "print-cards": "bun run src/scripts/printCards.ts"
  },
  "devDependencies": {
    "documentation": "^14.0.3"
  },
  "dependencies": {
    "@types/bun": "^1.2.17",
    "@types/jsdom": "^21.1.7",
    "jsdom": "^26.1.0"
  }
}
